# Copy to .env and fill real values. NEVER commit .env.
# All backend settings use the SENTINEL_ prefix (see backend/app/core/config.py).

# ClickHouse
SENTINEL_CLICKHOUSE_HOST=clickhouse
SENTINEL_CLICKHOUSE_PORT=8123
SENTINEL_CLICKHOUSE_USER=sentinel
SENTINEL_CLICKHOUSE_PASSWORD=change-me
SENTINEL_CLICKHOUSE_DATABASE=sentinel

# Redpanda (Kafka API)
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
SENTINEL_KAFKA_EVENTS_TOPIC=events
SENTINEL_KAFKA_DLQ_TOPIC=events_dlq

# App
SENTINEL_ENVIRONMENT=dev
SENTINEL_LOG_LEVEL=INFO
SENTINEL_FRONTEND_ORIGIN=http://localhost:3000

# Frontend
BACKEND_URL=http://localhost:8000

# --- AI Gateway (Phase 4) — leave blank until then. Free-tier keys only. ---
# Groq: quota is per-ORGANIZATION (not per key). Gemini: quota is per-PROJECT.
GROQ_KEY_1=
GROQ_KEY_2=
GEMINI_KEY_1=

# --- Connectors (Phase 5) — referenced from connector config as ${VAR}. ---
WAZUH_KEY=
WEBHOOK_TOKEN=
